{# Inlined rather than an asset bundle: an asset bundle means remembering `clear-caches/cp-resources`
   every time a rule changes, in exchange for saving one small style block per page.
   Colours, borders, radii and spacing are Craft's own tokens, so the screens follow the CP theme. #}
{% css %}
    .pwa-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
        gap: var(--m);
        margin-bottom: var(--xl);
    }
    .pwa-card {
        background: var(--gray-050);
        border: 1px solid var(--border-hairline);
        border-radius: var(--radius-lg);
        padding: var(--m) var(--l);
    }
    .pwa-card h2 {
        margin: 0 0 var(--xs);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--fg-subtle);
    }
    .pwa-figure { font-size: 1.625rem; line-height: 1.15; font-weight: 500; }
    .pwa-sub { font-size: 0.8125rem; color: var(--fg-subtle); }
    .pane > h2:first-child, .pane > h3:first-child { margin-top: 0; }

    /* The score dial. A number people read in one glance, so it gets one colour and no chrome. */
    .pwa-score {
        display: flex;
        align-items: center;
        gap: var(--l);
    }
    .pwa-score__value {
        font-size: 2.75rem;
        font-weight: 500;
        line-height: 1;
        font-variant-numeric: tabular-nums;
    }
    .pwa-score--good .pwa-score__value { color: var(--fg-success); }
    .pwa-score--fair .pwa-score__value { color: var(--fg-warning); }
    .pwa-score--poor .pwa-score__value { color: var(--fg-error); }

    .pwa-check {
        display: flex;
        gap: var(--m);
        padding: var(--m) 0;
        border-top: 1px solid var(--border-hairline);
        align-items: flex-start;
    }
    .pwa-check:first-of-type { border-top: 0; }
    .pwa-check__mark {
        flex: 0 0 auto;
        width: 1.25rem;
        height: 1.25rem;
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-size: 0.75rem;
        font-weight: 700;
        margin-top: 1px;
    }
    /* Tinted backgrounds with the matching foreground: the mark reads at AA contrast, and the
       status is also spelled out in visually-hidden text, so colour is never the only signal. */
    .pwa-check--pass .pwa-check__mark { background: var(--bg-success); color: var(--fg-success); }
    .pwa-check--warn .pwa-check__mark { background: var(--bg-warning); color: var(--fg-warning); }
    .pwa-check--fail .pwa-check__mark { background: var(--bg-error); color: var(--fg-error); }
    .pwa-check--skip .pwa-check__mark { background: var(--gray-100); color: var(--fg-subtle); }
    .pwa-check__label { font-weight: 500; }
    .pwa-check__label .badge { margin-inline-start: var(--s); vertical-align: middle; }
    .pwa-check__summary { color: var(--fg-subtle); }
    .pwa-check__fix {
        margin-top: var(--xs);
        padding: var(--s) var(--m);
        background: var(--gray-050);
        border-radius: var(--radius-md);
        font-size: 0.8125rem;
    }

    .pwa-group-heading {
        margin: var(--xl) 0 var(--xs);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--fg-subtle);
    }

    .pwa-icons { display: flex; flex-wrap: wrap; gap: var(--m); align-items: flex-end; }
    .pwa-icons figure { margin: 0; text-align: center; }
    .pwa-icons img {
        border: 1px solid var(--border-hairline);
        border-radius: var(--radius-lg);
        background: repeating-conic-gradient(var(--gray-100) 0 25%, var(--white) 0 50%) 50% / 12px 12px;
    }
    .pwa-icons figcaption { font-size: 0.75rem; color: var(--fg-subtle); margin-top: var(--xs); }

    .pwa-order { width: 1.5rem; color: var(--fg-subtle); font-variant-numeric: tabular-nums; }

    .pwa-sparkline { display: flex; align-items: flex-end; gap: 2px; height: 2.625rem; margin-top: var(--s); }
    .pwa-sparkline span {
        flex: 1 1 0;
        background: var(--blue-600);
        border-radius: 1px 1px 0 0;
        min-height: 1px;
    }
    {# The sparkline is drawn from data-* heights, not inline styles: one rule per tenth. #}
    {% for i in 0..10 %}
        .pwa-sparkline span[data-h="{{ i }}"] { height: {{ i * 10 }}%; }
    {% endfor %}

    .pwa-kv { display: grid; grid-template-columns: max-content 1fr; gap: var(--xs) var(--l); font-size: 0.8125rem; }
    .pwa-kv dt { color: var(--fg-subtle); }
    .pwa-kv dd { margin: 0; word-break: break-all; }

    .pwa-preview { max-height: 20rem; overflow: auto; font-size: 0.75rem; }
    .pwa-test-path { min-width: 18rem; }
    .pwa-inline-fields { display: flex; flex-wrap: wrap; gap: var(--m); align-items: flex-end; }
    .pwa-inline-fields .field { margin: 0; }
{% endcss %}
