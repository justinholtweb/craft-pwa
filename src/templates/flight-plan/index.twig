{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = "Flight plan"|t('pwa') %}
{% set selectedSubnavItem = 'flightplan' %}
{% set fullPageForm = isPro %}

{% block content %}
    {% include "pwa/_partials/style" %}

    <div class="pwa-panel">
        <h2>{{ "First match wins"|t('pwa') }}</h2>
        <p class="pwa-sub">
            {{ "The service worker walks these top to bottom and stops at the first rule that claims a request. The specific legs go first; the last one should match everything left."|t('pwa') }}
        </p>
        <p class="pwa-sub">
            {{ "The pages cache only ever stores navigations. A background poll or an XHR that falls through to the catch-all is fetched normally and not kept — otherwise a JSON endpoint with a cache-busting query string fills the bucket and evicts the pages somebody actually wanted offline."|t('pwa') }}
        </p>
    </div>

    {% if not isPro %}
        <div class="pwa-panel">
            <h3>{{ "The shipped defaults"|t('pwa') }}</h3>
            <p class="pwa-sub">
                {{ "These are what Lite runs, and they are deliberately conservative: pages from the network with a cached fallback, assets and images served from the cache and refreshed behind you, and the control panel never touched. Writing your own is a Pro feature."|t('pwa') }}
            </p>
            <table class="pwa-routes">
                <thead>
                    <tr>
                        <th class="pwa-order">#</th>
                        <th>{{ "Rule"|t('pwa') }}</th>
                        <th>{{ "Matches"|t('pwa') }}</th>
                        <th>{{ "Strategy"|t('pwa') }}</th>
                        <th>{{ "Cache"|t('pwa') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for route in routes %}
                        <tr>
                            <td class="pwa-order">{{ loop.index }}</td>
                            <td>{{ route.label }}</td>
                            <td><code>{{ route.pattern }}</code> <span class="pwa-sub">({{ matchTypes[route.match] }})</span></td>
                            <td>{{ route.strategyLabel }}</td>
                            <td>{{ route.strategy == 'networkOnly' ? '—' : caches[route.cache] }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        {{ actionInput('pwa/flight-plan/save') }}
        {{ redirectInput('pwa/flight-plan') }}

        <div class="pwa-panel">
            {% set rows = [] %}
            {% for route in routes %}
                {% set rows = rows|merge([{
                    label: route.label,
                    match: route.match,
                    pattern: route.pattern,
                    strategy: route.strategy,
                    cache: route.cache,
                    networkTimeout: route.networkTimeout,
                    offlineFallback: route.offlineFallback,
                    enabled: route.enabled,
                }]) %}
            {% endfor %}

            {{ forms.editableTableField({
                label: "Rules"|t('pwa'),
                instructions: "Drag to reorder. A network-only rule for the control panel belongs at the top and should stay there."|t('pwa'),
                id: 'routes',
                name: 'routes',
                cols: {
                    label: { heading: "Rule"|t('pwa'), type: 'singleline', width: '18%' },
                    match: { heading: "Match on"|t('pwa'), type: 'select', options: matchTypes, width: '12%' },
                    pattern: { heading: "Pattern"|t('pwa'), type: 'singleline', code: true, width: '18%' },
                    strategy: { heading: "Strategy"|t('pwa'), type: 'select', options: strategies },
                    cache: { heading: "Cache"|t('pwa'), type: 'select', options: caches, width: '10%' },
                    networkTimeout: { heading: "Timeout"|t('pwa'), type: 'number', width: '8%' },
                    offlineFallback: { heading: "Offline page"|t('pwa'), type: 'lightswitch', width: '8%' },
                    enabled: { heading: "On"|t('pwa'), type: 'lightswitch', width: '6%' },
                },
                rows: rows,
                addRowLabel: "Add a rule"|t('pwa'),
            }) }}

            <p class="pwa-sub">
                {{ "Patterns take * and ?, and a comma separates alternatives. Match on the path (/blog/*), a file extension (pdf,zip), the browser's own request type (image, script, style, font, document) or the host."|t('pwa') }}
            </p>
        </div>

        <div class="pwa-panel">
            <h3>{{ "Test a URL"|t('pwa') }}</h3>
            <p class="pwa-sub">{{ "Which rule would claim it — the answer to “why is this page not caching?”"|t('pwa') }}</p>
            <div class="flex">
                <input type="text" class="text" id="pwa-test-path" placeholder="/blog/some-article" style="min-width:280px">
                <select id="pwa-test-destination" class="text">
                    <option value="document">{{ "Page"|t('pwa') }}</option>
                    <option value="image">{{ "Image"|t('pwa') }}</option>
                    <option value="script">{{ "Script"|t('pwa') }}</option>
                    <option value="style">{{ "Stylesheet"|t('pwa') }}</option>
                    <option value="font">{{ "Font"|t('pwa') }}</option>
                </select>
                <button type="button" class="btn" id="pwa-test-run">{{ "Test"|t('pwa') }}</button>
            </div>
            <p id="pwa-test-result" class="pwa-sub" style="margin-top:10px"></p>
        </div>

        <div class="pwa-panel">
            <button type="button" class="btn" id="pwa-reset">{{ "Reset to the defaults"|t('pwa') }}</button>
            <span class="pwa-sub">{{ "Throws away your rules and goes back to the shipped ones."|t('pwa') }}</span>
        </div>
    {% endif %}
{% endblock %}

{% if isPro %}
    {% js %}
        document.getElementById('pwa-test-run')?.addEventListener('click', function() {
            const path = document.getElementById('pwa-test-path').value || '/';
            const destination = document.getElementById('pwa-test-destination').value;
            const result = document.getElementById('pwa-test-result');

            Craft.sendActionRequest('POST', 'pwa/flight-plan/test', { data: { path, destination } })
                .then(response => {
                    const data = response.data;
                    result.textContent = data.matched
                        ? Craft.t('pwa', 'Rule {n} ({label}) — {strategy}', {
                            n: data.index + 1,
                            label: data.label || '—',
                            strategy: data.strategyLabel,
                          })
                        : Craft.t('pwa', 'No rule matches, so the worker leaves this request alone.');
                })
                .catch(() => Craft.cp.displayError(Craft.t('pwa', 'Could not test that URL.')));
        });

        // Posted from JS: this page is a form already, and a second one inside it does not fail
        // cleanly — the browser merges its inputs into the outer form.
        document.getElementById('pwa-reset')?.addEventListener('click', function() {
            if (!confirm(Craft.t('pwa', 'Reset the flight plan to the shipped defaults?'))) return;

            Craft.sendActionRequest('POST', 'pwa/flight-plan/reset')
                .then(() => window.location.reload())
                .catch(() => Craft.cp.displayError(Craft.t('pwa', 'Could not reset the flight plan.')));
        });
    {% endjs %}
{% endif %}
