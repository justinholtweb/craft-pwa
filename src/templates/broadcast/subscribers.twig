{% extends "_layouts/cp" %}

{% set title = "Devices"|t('pwa') %}
{% set selectedSubnavItem = 'broadcast' %}
{% set crumbs = [{ label: "Broadcast"|t('pwa'), url: url('pwa/broadcast') }] %}

{% block content %}
    {% include "pwa/_partials/style" %}

    <div class="pwa-cards">
        <div class="pwa-card">
            <h4>{{ "Total"|t('pwa') }}</h4>
            <div class="pwa-figure">{{ total|number_format }}</div>
            <div class="pwa-sub">{{ "browsers, not people"|t('pwa') }}</div>
        </div>
        {% for service, count in byService %}
            <div class="pwa-card">
                <h4>{{ service }}</h4>
                <div class="pwa-figure">{{ count|number_format }}</div>
                <div class="pwa-sub">{{ "push service"|t('pwa') }}</div>
            </div>
        {% endfor %}
    </div>

    <div class="pwa-panel">
        <p class="pwa-sub">
            {{ "Removing a device here stops us sending to it. It does not unsubscribe the browser — only the browser can do that, from the site."|t('pwa') }}
        </p>

        {% if subscribers|length %}
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th>{{ "Service"|t('pwa') }}</th>
                        <th>{{ "User"|t('pwa') }}</th>
                        <th>{{ "Topics"|t('pwa') }}</th>
                        <th>{{ "Subscribed"|t('pwa') }}</th>
                        <th>{{ "Last reached"|t('pwa') }}</th>
                        <th>{{ "Failures"|t('pwa') }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for subscriber in subscribers %}
                        <tr data-id="{{ subscriber.id }}">
                            <td>{{ subscriber.service }}</td>
                            <td>{{ subscriber.userId ? craft.users.id(subscriber.userId).one().username ?? '—' : '—' }}</td>
                            <td>{{ subscriber.topics|join(', ') ?: '—' }}</td>
                            <td>{{ subscriber.dateCreated ? subscriber.dateCreated|datetime('short') : '—' }}</td>
                            <td>{{ subscriber.dateLastSeen ? subscriber.dateLastSeen|datetime('short') : '—' }}</td>
                            <td>{{ subscriber.failures ?: '—' }}</td>
                            <td class="thin">
                                <button type="button" class="btn small pwa-remove" data-id="{{ subscriber.id }}">{{ "Remove"|t('pwa') }}</button>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p>{{ "Nobody has subscribed yet. Add a subscribe button to your templates — {{ pwa.pushEnabled }} tells you whether to show one, and window.pwa.subscribe() does the rest."|t('pwa') }}</p>
        {% endif %}
    </div>
{% endblock %}

{% js %}
    document.querySelectorAll('.pwa-remove').forEach(function(button) {
        button.addEventListener('click', function() {
            Craft.sendActionRequest('POST', 'pwa/broadcast/remove-subscriber', { data: { subscriberId: this.dataset.id } })
                .then(() => document.querySelector('tr[data-id="' + this.dataset.id + '"]')?.remove())
                .catch(() => Craft.cp.displayError(Craft.t('pwa', 'Could not remove that device.')));
        });
    });
{% endjs %}
