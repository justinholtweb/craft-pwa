{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = isNew ? "New broadcast"|t('pwa') : campaign.title %}
{% set selectedSubnavItem = 'broadcast' %}
{% set crumbs = [{ label: "Broadcast"|t('pwa'), url: url('pwa/broadcast') }] %}
{% set sent = campaign.status in ['sent', 'sending'] %}
{% set fullPageForm = not sent %}

{% block content %}
    {% include "pwa/_partials/style" %}

    {% if sent %}
        <div class="pwa-panel">
            <h2>{{ campaign.statusLabel }}</h2>
            <dl class="pwa-kv">
                <dt>{{ "Sent"|t('pwa') }}</dt>
                <dd>{{ campaign.dateSent ? campaign.dateSent|datetime('short') : '—' }}</dd>
                <dt>{{ "Aimed at"|t('pwa') }}</dt>
                <dd>{{ campaign.targeted }} {{ "device(s)"|t('pwa') }}</dd>
                <dt>{{ "Delivered"|t('pwa') }}</dt>
                <dd>{{ campaign.delivered }}</dd>
                <dt>{{ "Failed"|t('pwa') }}</dt>
                <dd>{{ campaign.failed }}</dd>
                {% for status, count in breakdown %}
                    <dt>{{ status }}</dt><dd>{{ count }}</dd>
                {% endfor %}
            </dl>
            <p class="pwa-sub" style="margin-top:12px">
                {{ "A sent broadcast cannot be edited or recalled. Devices recorded as “gone” were dropped from the list — the push service had already retired them."|t('pwa') }}
            </p>
        </div>

        <div class="pwa-panel">
            <h3>{{ "What was sent"|t('pwa') }}</h3>
            <dl class="pwa-kv">
                <dt>{{ "Title"|t('pwa') }}</dt><dd>{{ campaign.title }}</dd>
                <dt>{{ "Body"|t('pwa') }}</dt><dd>{{ campaign.body }}</dd>
                <dt>{{ "Opens"|t('pwa') }}</dt><dd>{{ campaign.url ?: '—' }}</dd>
            </dl>
        </div>
    {% else %}
        {{ actionInput('pwa/broadcast/save') }}
        {{ hiddenInput('campaignId', campaign.id) }}

        <div class="pwa-panel">
            <h2>{{ "The notification"|t('pwa') }}</h2>

            {{ forms.textField({
                label: "Title"|t('pwa'),
                instructions: "Shown in bold on the device. Keep it under about forty characters — Android truncates, iOS wraps once."|t('pwa'),
                id: 'title',
                name: 'title',
                value: campaign.title,
                required: true,
                maxlength: 120,
            }) }}

            {{ forms.textareaField({
                label: "Body"|t('pwa'),
                id: 'body',
                name: 'body',
                value: campaign.body,
                rows: 3,
                maxlength: 400,
            }) }}

            {{ forms.textField({
                label: "Opens"|t('pwa'),
                instructions: "Where a tap lands. Relative to the site."|t('pwa'),
                id: 'url',
                name: 'url',
                value: campaign.url,
                placeholder: '/',
            }) }}

            {{ forms.textField({
                label: "Collapse tag"|t('pwa'),
                instructions: "Two notifications with the same tag replace each other on the device. Right for anything that supersedes itself — a score, a status — and wrong for anything that does not."|t('pwa'),
                id: 'tag',
                name: 'tag',
                value: campaign.tag,
            }) }}
        </div>

        <div class="pwa-panel">
            <h2>{{ "Who gets it"|t('pwa') }}</h2>

            {{ forms.selectField({
                label: "Site"|t('pwa'),
                id: 'siteId',
                name: 'siteId',
                value: campaign.siteId,
                options: [{ label: "Every site"|t('pwa'), value: '' }]|merge(sites|map(s => { label: s.name, value: s.id })),
            }) }}

            {{ forms.textField({
                label: "Topics"|t('pwa'),
                instructions: "Comma separated. Only devices that subscribed to one of these receive it; leave empty to reach everybody."|t('pwa'),
                id: 'topics',
                name: 'topics',
                value: campaign.topics|join(', '),
            }) }}

            {{ forms.dateTimeField({
                label: "Send at"|t('pwa'),
                instructions: "Leave empty to send by hand. A scheduled broadcast goes out when pwa/broadcast/due next runs."|t('pwa'),
                id: 'dateScheduled',
                name: 'dateScheduled',
                value: campaign.dateScheduled,
            }) }}

            <p class="pwa-sub">
                {{ "{count} device(s) match right now."|t('pwa', { count: subscribers }) }}
            </p>
        </div>

        {% if not isNew %}
            <div class="pwa-panel pwa-danger">
                <h3>{{ "Send it"|t('pwa') }}</h3>
                <p>
                    {{ "This reaches people who are not on the site, on devices they are holding. It cannot be edited, recalled or deleted afterwards."|t('pwa') }}
                </p>
                <div class="flex" style="margin-top:10px">
                    <input type="text" class="text" id="pwa-confirm" placeholder="{{ 'Type SEND'|t('pwa') }}" size="12" autocomplete="off">
                    <button type="button" class="btn submit disabled" id="pwa-send" disabled>{{ "Send to {count} device(s)"|t('pwa', { count: subscribers }) }}</button>
                </div>
                <p class="pwa-sub" style="margin-top:6px">
                    {{ "Typing it out is not a formality — it is the one thing that cannot happen by accident, by a double click, or by a browser restoring this form on back-navigation."|t('pwa') }}
                </p>
            </div>
        {% else %}
            <div class="pwa-panel">
                <p class="pwa-sub">{{ "Save it first. Sending is a separate, deliberate step."|t('pwa') }}</p>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}

{% if not sent and not isNew %}
    {% js %}
        const confirmField = document.getElementById('pwa-confirm');
        const sendButton = document.getElementById('pwa-send');

        confirmField?.addEventListener('input', function() {
            const armed = this.value.trim() === 'SEND';
            sendButton.disabled = !armed;
            sendButton.classList.toggle('disabled', !armed);
        });

        // Posted on its own rather than by re-pointing the page form: sending what is *saved* is
        // the honest thing to do, and submitting the edit form would send whatever happened to be
        // typed into it without saving that anywhere.
        sendButton?.addEventListener('click', function() {
            if (this.disabled) return;

            this.classList.add('loading');

            Craft.sendActionRequest('POST', 'pwa/broadcast/send', {
                data: { campaignId: {{ campaign.id }}, confirm: confirmField.value.trim() },
            })
                .then(response => {
                    Craft.cp.displayNotice(response.data.message);
                    window.location.reload();
                })
                .catch(e => Craft.cp.displayError(e?.response?.data?.message || Craft.t('pwa', 'Could not send.')))
                .finally(() => this.classList.remove('loading'));
        });
    {% endjs %}
{% endif %}
