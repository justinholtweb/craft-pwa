{% extends "_layouts/cp" %}

{% set title = "Broadcast"|t('pwa') %}
{% set selectedSubnavItem = 'broadcast' %}

{% block actionButton %}
    <a class="btn" href="{{ url('pwa/broadcast/subscribers') }}">{{ "Devices"|t('pwa') }}</a>
    <a class="btn submit" href="{{ url('pwa/broadcast/new') }}">{{ "New broadcast"|t('pwa') }}</a>
{% endblock %}

{% block content %}
    {% include "pwa/_partials/style" %}

    {% if not pushEnabled %}
        <div class="pwa-panel pwa-danger">
            <h2>{{ "Push is switched off"|t('pwa') }}</h2>
            <p>{{ "Nobody can subscribe and nothing can be sent until it is turned on in Settings → Push."|t('pwa') }}</p>
        </div>
    {% endif %}

    <div class="pwa-cards">
        <div class="pwa-card">
            <h4>{{ "Subscribed devices"|t('pwa') }}</h4>
            <div class="pwa-figure">{{ subscribers|number_format }}</div>
            <div class="pwa-sub">{{ "one per browser, not per person"|t('pwa') }}</div>
        </div>
        <div class="pwa-card">
            <h4>{{ "Broadcasts"|t('pwa') }}</h4>
            <div class="pwa-figure">{{ campaigns|length }}</div>
            <div class="pwa-sub">{{ "most recent 50"|t('pwa') }}</div>
        </div>
    </div>

    <div class="pwa-panel">
        {% if campaigns|length %}
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th>{{ "Title"|t('pwa') }}</th>
                        <th>{{ "Status"|t('pwa') }}</th>
                        <th>{{ "Sent"|t('pwa') }}</th>
                        <th>{{ "Delivered"|t('pwa') }}</th>
                        <th>{{ "Failed"|t('pwa') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for campaign in campaigns %}
                        <tr>
                            <td><a href="{{ url('pwa/broadcast/' ~ campaign.id) }}">{{ campaign.title }}</a></td>
                            <td>{{ campaign.statusLabel }}</td>
                            <td>{{ campaign.dateSent ? campaign.dateSent|datetime('short') : '—' }}</td>
                            <td>{{ campaign.delivered }} / {{ campaign.targeted }}</td>
                            <td>{{ campaign.failed ?: '—' }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p>{{ "Nothing has been broadcast yet."|t('pwa') }}</p>
        {% endif %}
    </div>
{% endblock %}
