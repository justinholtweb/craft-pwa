{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = "PWA settings"|t('pwa') %}
{% set selectedSubnavItem = 'settings' %}
{% set fullPageForm = true %}

{# Not `tabs`: that name belongs to Craft's own CP layout, which merges its own structure into
   whatever is under it — and a plain map of labels makes it fail with a type error from inside a
   compiled template, a long way from here. #}
{% set panes = {
    general: "General"|t('pwa'),
    offline: "Offline"|t('pwa'),
    prompt: "Install prompt"|t('pwa'),
    push: "Push"|t('pwa'),
} %}

{% block content %}
    {% include "pwa/_partials/style" %}

    {{ actionInput('pwa/settings/save') }}
    {{ hiddenInput('section', section) }}

    <div class="pwa-panel">
        <div class="flex">
            {% for key, label in panes %}
                <a class="btn{{ key == section ? ' active' : '' }}" href="{{ url('pwa/settings/' ~ key) }}">{{ label }}</a>
            {% endfor %}
        </div>
        <p class="pwa-sub" style="margin-top:10px">
            {{ "Each tab saves on its own. Everything here lives in project config, so it deploys with the code that assumes it."|t('pwa') }}
        </p>
    </div>

    {% include 'pwa/settings/_' ~ section %}
{% endblock %}
